{
  "env": {
    "PYTHONUNBUFFERED": "1"
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(/opt/miniconda3/envs/langchain/bin/python *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./checkpoints.sqlite*)"
    ],
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)"
    ]
  },
  "sandbox": {
    "network": {
      "allowedDomains": [
        "api.openai.com",
        "api.tavily.com",
        "api.heygen.com",
        "discord.com",
        "*.discord.gg",
        "api.anthropic.com"
      ]
    }
  }
}
