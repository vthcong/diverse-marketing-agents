{
  "env": {
    "PYTHONUNBUFFERED": "1"
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(/opt/miniconda3/envs/langchain/bin/python *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./checkpoints.sqlite*)"
    ],
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "mcp__heygen__start_video_render",
      "mcp__claude_ai_Notion__notion-create-pages",
      "mcp__claude_ai_Notion__notion-update-page"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__heygen__start_video_render",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/miniconda3/envs/langchain/bin/python \"$CLAUDE_PROJECT_DIR/.claude/hooks/render_gate.py\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash .claude/statusline.sh"
  },
  "sandbox": {
    "network": {
      "allowedDomains": [
        "api.openai.com",
        "api.tavily.com",
        "api.heygen.com",
        "discord.com",
        "*.discord.gg",
        "api.anthropic.com"
      ]
    }
  }
}
